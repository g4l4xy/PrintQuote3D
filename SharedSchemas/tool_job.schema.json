{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolJob v2",
  "type": "object",
  "properties": {
    "system": {
      "type": "object",
      "properties": {
        "availableToolheadCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "toolheads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "architecture": {
          "enum": [
            "singleTool",
            "singleNozzleSwitcher",
            "idex",
            "dualExtruder",
            "fixedMultiNozzle",
            "toolChanger",
            "mixingHotend",
            "custom"
          ]
        },
        "simultaneousToolUseCount": {
          "type": "integer",
          "minimum": 0
        },
        "filamentInputCount": {
          "type": "integer",
          "minimum": 0
        },
        "feederSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxSimultaneousMaterials": {
          "type": "integer",
          "minimum": 0
        },
        "maxAutomaticSelectableMaterials": {
          "type": "integer",
          "minimum": 0
        },
        "automaticMaterialSwitching": {
          "type": "boolean"
        },
        "sharedNozzle": {
          "type": "boolean"
        },
        "materialSwitchSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "purgeGramsPerMaterialSwitch": {
          "type": "integer",
          "minimum": 0
        },
        "needsReview": {
          "type": "boolean"
        }
      },
      "required": [
        "availableToolheadCount",
        "toolheads",
        "architecture",
        "simultaneousToolUseCount",
        "filamentInputCount",
        "feederSlotCount",
        "maxSimultaneousMaterials",
        "maxAutomaticSelectableMaterials",
        "automaticMaterialSwitching",
        "sharedNozzle",
        "materialSwitchSeconds",
        "purgeGramsPerMaterialSwitch",
        "needsReview"
      ],
      "additionalProperties": false
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "toolIndex": {
            "type": "integer",
            "minimum": 0
          },
          "feederSlot": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "materialName": {
            "type": "string"
          },
          "materialFamily": {
            "type": "string"
          },
          "colorName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "grams": {
            "type": "integer",
            "minimum": 0
          },
          "pricePerKG": {
            "type": "integer",
            "minimum": 0
          },
          "activeHours": {
            "type": "integer",
            "minimum": 0
          },
          "activationCount": {
            "type": "integer",
            "minimum": 0
          },
          "abrasive": {
            "type": "boolean"
          },
          "flexible": {
            "type": "boolean"
          },
          "materialID": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "toolIndex",
          "materialName",
          "materialFamily",
          "colorName",
          "role",
          "grams",
          "pricePerKG",
          "activeHours",
          "activationCount",
          "abrasive",
          "flexible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "system",
    "assignments"
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "name": {
          "type": "string"
        },
        "nozzleDiameterMM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nozzleMaterial": {
          "type": "string"
        },
        "supportedMaterialFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abrasiveMaterialsAllowed": {
          "type": "boolean"
        },
        "flexibleMaterialsAllowed": {
          "type": "boolean"
        },
        "changeOverheadSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "purgeGramsPerActivation": {
          "type": "integer",
          "minimum": 0
        },
        "wipeGramsPerActivation": {
          "type": "integer",
          "minimum": 0
        },
        "additionalHeaterWatts": {
          "type": "integer",
          "minimum": 0
        },
        "parkedHeaterWatts": {
          "type": "integer",
          "minimum": 0
        },
        "maintenancePerHour": {
          "type": "integer",
          "minimum": 0
        },
        "nozzleReplacementCost": {
          "type": "integer",
          "minimum": 0
        },
        "nozzleLifeHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "abrasiveWearMultiplier": {
          "type": "integer",
          "minimum": 0
        },
        "needsReview": {
          "type": "boolean"
        },
        "maxNozzleTemperatureC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "index",
        "name",
        "nozzleDiameterMM",
        "nozzleMaterial",
        "supportedMaterialFamilies",
        "abrasiveMaterialsAllowed",
        "flexibleMaterialsAllowed",
        "changeOverheadSeconds",
        "purgeGramsPerActivation",
        "wipeGramsPerActivation",
        "additionalHeaterWatts",
        "parkedHeaterWatts",
        "maintenancePerHour",
        "nozzleReplacementCost",
        "nozzleLifeHours",
        "abrasiveWearMultiplier",
        "needsReview"
      ],
      "additionalProperties": false
    }
  }
}
